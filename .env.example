# Copia este archivo como .env y completa los valores. .env nunca se versiona.
# Spring Boot lo carga automáticamente desde la raíz del proyecto (spring.config.import).

# ---------- Base de datos (PostgreSQL 16) ----------
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=simutalk
DB_PASSWORD=change-me

# ---------- Servidor ----------
SERVER_PORT=8080

# ---------- Autenticación (contexto iam) ----------
# Base64 de al menos 256 bits. Genera uno con: openssl rand -base64 32
JWT_SECRET=
JWT_EXPIRATION_DAYS=7

# Opcional: administrador inicial (el registro público no permite ROLE_ADMIN).
# Si ambos tienen valor, se crea al arrancar si todavía no existe.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ---------- Contexto profiles ----------
# mock (por defecto, sin red) | live
CREDENTIALS_MODE=mock
# true para sembrar datos demo (1 empresa, 6 candidatos) si no hay perfiles
SEED_DEMO_DATA=false
# Contraseña de los usuarios demo (consultora.andina, rosa.quispe, jorge.huaman, ...)
DEMO_USERS_PASSWORD=

# ---------- Contexto analytics ----------
# kg CO2e por km recorrido (valor de referencia; validarlo con una fuente citable)
SUSTAINABILITY_EMISSION_FACTOR=0.12

# ---------- Contexto assessment (proveedor de IA) ----------
# mock (por defecto, sin red) | live (Google Gemini)
AI_MODE=mock
# Obligatoria solo en modo live
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Opcional: clave de los códigos CANDIDATO-X-9999 (si falta, se deriva de JWT_SECRET)
ANONYMIZATION_SECRET=
