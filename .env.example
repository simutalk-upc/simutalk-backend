# Copia este archivo como .env y completa los valores. .env nunca se versiona.
# Spring Boot lo carga automáticamente desde la raíz del proyecto (spring.config.import).

# ---------- Base de datos (PostgreSQL 16) ----------
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=simutalk
DB_PASSWORD=change-me

# ---------- Servidor ----------
SERVER_PORT=8080

# ---------- Autenticación (contexto iam) ----------
# Base64 de al menos 256 bits. Genera uno con: openssl rand -base64 32
JWT_SECRET=
JWT_EXPIRATION_DAYS=7

# Opcional: administrador inicial (el registro público no permite ROLE_ADMIN).
# Si ambos tienen valor, se crea al arrancar si todavía no existe.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ---------- Pendiente: contexto evaluation (proveedor de IA) ----------
# AI_PROVIDER_BASE_URL=
# AI_PROVIDER_API_KEY=
